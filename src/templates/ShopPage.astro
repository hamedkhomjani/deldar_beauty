---
/**
 * Shop page template — product grid with add-to-cart buttons (handled by cart.ts).
 * Cards carry data-id/data-price so the cart can resolve bilingual names.
 */
import Layout from '../components/Layout.astro';
import { PRODUCTS, imageSize } from '../data/products';
import { productListSchema, breadcrumbSchema, webPageSchema } from '../data/schema';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);

const priceLocale = lang === 'en' ? 'en-US' : 'fa-IR';

const jsonLd = [
  productListSchema(PRODUCTS, lang),
  webPageSchema('/shop', dict.shopTitle, lang),
  breadcrumbSchema([
    { name: lang === 'en' ? 'Home' : 'خانه', item: lang === 'en' ? '/en/' : '/' },
    { name: lang === 'en' ? 'Shop' : 'فروشگاه', item: lang === 'en' ? '/en/shop' : '/shop' },
  ]),
];
---

<Layout
  title={dict.shopTitle}
  description={dict.shopDescription}
  lang={lang}
  jsonLd={jsonLd}
>
  <main id="main-content" class="shop-page container">
    <header class="shop-header" data-reveal>
      <p class="section-tagline">{dict.shopTagline}</p>
      <h1>{dict.shopH1a} <span class="text-gradient">{dict.shopH1b}</span></h1>
      <p>{dict.shopSub}</p>
    </header>

    <div id="shop-product-grid" class="product-grid">
      {
        PRODUCTS.map((product) => (
          <div class="product-card" data-reveal data-product-id={product.id} data-product-price={product.price}>
            {product.badge && <span class="product-badge">{product.badge[lang]}</span>}
            <div class="product-image">
              <img src={product.image} alt={product.alt[lang]} width={imageSize(product.image).width} height={imageSize(product.image).height} loading="lazy" decoding="async" />
            </div>
            <div class="product-info">
              <span class="product-category">{product.category[lang]}</span>
              <h3 class="product-title">{product.name[lang]}</h3>
              <p class="product-price">{product.price.toLocaleString(priceLocale)} {dict.currency}</p>
              <button class="btn-add-cart">{dict.addToCart}</button>
            </div>
          </div>
        ))
      }
    </div>
  </main>
</Layout>

<script>
  import { getAdminProducts, type AdminProduct } from '../scripts/adminStore';
  import { asset } from '../config';

  document.addEventListener('DOMContentLoaded', () => {
    const raw = localStorage.getItem('deldar_custom_products');
    if (!raw) return;

    try {
      const products: AdminProduct[] = getAdminProducts();
      const grid = document.getElementById('shop-product-grid');
      if (!grid || products.length === 0) return;

      const lang = (document.documentElement.lang || 'fa') as 'fa' | 'en';
      const currency = lang === 'en' ? 'Toman' : 'تومان';
      const priceLocale = lang === 'en' ? 'en-US' : 'fa-IR';
      const addToCartText = lang === 'en' ? 'Add to Cart' : 'افزودن به سبد خرید';
      const outOfStockText = lang === 'en' ? 'Out of Stock' : 'ناموجود';

      grid.innerHTML = products
        .map((product) => {
          const inStock = product.inStock !== false;
          const badgeHtml = product.badge ? `<span class="product-badge">${product.badge[lang] || product.badge.fa}</span>` : '';
          const stockBadgeHtml = !inStock ? `<span class="product-badge out-of-stock">${outOfStockText}</span>` : '';

          return `
            <div class="product-card ${!inStock ? 'is-out-of-stock' : ''}" data-product-id="${product.id}" data-product-price="${product.price}">
              ${badgeHtml || stockBadgeHtml}
              <div class="product-image">
                <img src="${asset(product.image)}" alt="${product.alt[lang] || product.alt.fa}" loading="lazy" />
              </div>
              <div class="product-info">
                <span class="product-category">${product.category[lang] || product.category.fa}</span>
                <h3 class="product-title">${product.name[lang] || product.name.fa}</h3>
                <p class="product-price">${product.price.toLocaleString(priceLocale)} ${currency}</p>
                <button class="btn-add-cart" ${!inStock ? 'disabled' : ''}>${!inStock ? outOfStockText : addToCartText}</button>
              </div>
            </div>
          `;
        })
        .join('');
    } catch (e) {
      console.error('Failed to parse dynamic products:', e);
    }
  });
</script>

