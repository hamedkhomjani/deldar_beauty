---
/**
 * Booking page template — standalone calendar + time slots + details form.
 * Reuses the modal's markup and the logic in scripts/booking.ts.
 */
import Layout from '../components/Layout.astro';
import { bookingServiceNames } from '../data/services';
import { breadcrumbSchema } from '../data/schema';
import { asset } from '../config';
import { t, localizedPath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const services = bookingServiceNames(lang);

const jsonLd = [
  breadcrumbSchema([
    { name: lang === 'en' ? 'Home' : 'خانه', item: lang === 'en' ? '/en/' : '/' },
    {
      name: lang === 'en' ? 'Book Online' : 'رزرو نوبت',
      item: lang === 'en' ? '/en/booking/' : '/booking/',
    },
  ]),
];
---

<Layout
  title={dict.bookingPageTitle}
  description={dict.bookingPageDescription}
  lang={lang}
  bodyClass="booking-page"
  jsonLd={jsonLd}
  noBookingModal
  hideBookingDock
>
  <main class="booking-page-main">
    <div class="booking-page-header container" data-reveal>
      <img src={asset('assets/images/logo.svg')} alt={dict.logoAlt} class="booking-page-logo" />
      <h1>{dict.bookingPageH1}</h1>
      <p>{dict.bookingPageSub}</p>
    </div>

    <div id="booking-page" class="container">
      <div class="booking-grid">
        <div class="calendar-container">
          <h3>{dict.chooseDay}</h3>
          <div class="calendar-card">
            <div class="calendar-header">
              <span class="prev-month" aria-label={dict.prevMonthAria}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </span>
              <span class="current-month"></span>
              <span class="next-month" aria-label={dict.nextMonthAria}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </span>
            </div>
            <div class="calendar-body">
              <div class="days-header">
                {dict.weekdays.map((d) => <span>{d}</span>)}
              </div>
              <div class="days-grid" id="calendar-days"></div>
              <div class="quick-days">
                <button type="button" class="quick-day" data-offset="0">{dict.today}</button>
                <button type="button" class="quick-day" data-offset="1">{dict.tomorrow}</button>
              </div>
            </div>
          </div>
        </div>

        <div class="time-container">
          <h3>{dict.chooseTime}</h3>
          <div class="time-slots" id="time-slots">
            {dict.timeSlots.map((slot, i) => (
              <button class:list={['time-slot', { active: i === 1 }]}>{slot}</button>
            ))}
          </div>
          <div class="time-legend">
            <span><i class="dot reserved"></i> {dict.reservedLegend}</span>
            <span><i class="dot available"></i> {dict.availableLegend}</span>
          </div>
          <p id="booking-summary" class="booking-summary">{dict.summaryPlaceholder}</p>
        </div>
      </div>

      <div class="details-section">
        <h3>{dict.detailsHeading}</h3>
        <form id="booking-form" class="booking-form">
          <div class="form-group">
            <select id="booking-service" required>
              <option value="" disabled selected>{dict.servicePlaceholder}</option>
              {services.map((name) => <option>{name}</option>)}
              <option>{dict.freeConsultOption}</option>
            </select>
            <span class="required-star">*</span>
          </div>
          <div class="form-row">
            <div class="form-group">
              <input type="text" id="booking-name" placeholder={dict.namePlaceholder} required />
              <span class="required-star">*</span>
            </div>
            <div class="form-group">
              <input type="tel" id="booking-phone" placeholder={dict.phonePlaceholder} required />
              <span class="required-star">*</span>
            </div>
          </div>
          <div class="form-group">
            <input type="email" id="booking-email" placeholder={dict.emailPlaceholder} />
          </div>
          <p id="booking-form-msg" class="form-msg"></p>
          <button type="submit" class="btn-confirm">{dict.bookingSubmitBtn}</button>
        </form>
      </div>

      <div id="booking-success" class="booking-success hidden">
        <div class="success-content">
          <div class="success-icon">
            <svg viewBox="0 0 24 24" width="80" height="80" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h2>{dict.bookingSuccessHeading}</h2>
          <p>
            {dict.bookingSuccessText}
          </p>
          <a class="btn-back" href={localizedPath('/', lang)}>{dict.bookingBackHome}</a>
        </div>
      </div>
    </div>
  </main>
</Layout>
