---
/**
 * Homepage — hero, services, lookbook/testimonials, consultation, FAQ, contact.
 */
import Layout from '../components/Layout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { SERVICES } from '../data/services';
import { FAQS } from '../data/faq';
import { beautySalonSchema, webSiteSchema, faqSchema, breadcrumbSchema } from '../data/schema';
import { asset, pageUrl } from '../config';

const jsonLd = [
  beautySalonSchema(SERVICES),
  breadcrumbSchema([{ name: 'خانه', item: '/' }]),
  webSiteSchema(),
  faqSchema(FAQS),
];
---

<Layout
  title="سالن زیبایی زنانه دلدار در تهران | رزرو آنلاین نوبت، رنگ و لایت، کاشت ناخن"
  description="سالن زیبایی زنانه دلدار در تهران؛ خدمات تخصصی آرایش عروس، رنگ و لایت حرفه‌ای، کاشت ناخن و مراقبت از پوست و مو در محیطی لوکس. رزرو آنلاین نوبت همین حالا."
  bodyClass="home-page"
  jsonLd={jsonLd}
  preloadHero
>
  <div id="preloader" class="preloader">
    <div class="preloader-content">
      <img src={asset('assets/images/logo.svg')} alt="لوگوی سالن زیبایی دلدار" class="preloader-logo" />
      <div class="preloader-bar"></div>
    </div>
  </div>

  <main>
    <!-- Hero Section -->
    <section id="hero" class="hero">
      <div class="hero-bg-accent"></div>
      <div class="container hero-content">
        <div class="hero-text" data-reveal>
          <h1>درخشش و زیبایی شما، <br /><span class="text-gradient">اولویت اول ماست</span></h1>
          <p>در سالن زیبایی دلدار، ما هنر زیبایی را با علم روز ترکیب کرده‌ایم تا تجربه‌ای بی‌نظیر و ماندگار برای شما
            خلق کنیم.</p>
          <div class="hero-btns" data-reveal>
            <a href={pageUrl('/booking')} class="btn-premium go-booking">
              رزرو نوبت آنلاین
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 19l-7-7 7-7" />
              </svg>
            </a>
            <a href="#services" class="btn-outline">
              مشاهده خدمات
            </a>
          </div>
        </div>
        <div class="hero-image-wrapper" data-reveal>
          <div class="hero-image">
            <img src={asset('assets/images/hero.webp')} alt="مدل زیبایی دلدار" />
            <div class="image-gradient-overlay"></div>
          </div>
          <div class="floating-card-1">
            <span class="count">10k+</span>
            <span class="label">مشتری راضی</span>
          </div>
          <div class="floating-card-2">
            <div class="stars">★★★★★</div>
            <span class="label">خدمات وی‌آی‌پی</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="services-section container">
      <div class="section-header" data-reveal>
        <h2>خدمات تخصصی ما</h2>
        <p>انتخابی هوشمندانه برای درخشش در هر لحظه</p>
      </div>
      <div class="services">
        {
          SERVICES.map((service) => (
            <div class="service-card" data-reveal>
              <ServiceIcon icon={service.icon} />
              <h3>{service.name}</h3>
              <p>{service.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Lookbook & Testimonials Section -->
    <section id="lookbook" class="lookbook-section container">
      <div class="section-header" data-reveal>
        <p class="section-tagline">هنر و تخصص</p>
        <h2>لوک‌بوک و روایت‌های دلدار</h2>
        <p>داستانِ درخشش مشتریان ما از زبانِ خودشان</p>
      </div>

      <div class="lookbook-grid">
        <div class="lookbook-item card-large" data-reveal>
          <img src={asset('assets/images/hero.webp')} alt="نمونه کار رنگ و مش و شینیون حرفه‌ای سالن دلدار" loading="lazy" />
          <div class="testimonial-overlay">
            <div class="testimonial-content">
              <p>"تجربه استایلینگ در دلدار برای من فراتر از یک تغییر ظاهر بود. حس اعتماد به نفسی که گرفتم
                بی‌نظیر است."</p>
              <span class="client-name">— سارا احمدی</span>
            </div>
          </div>
        </div>
        <div class="lookbook-item" data-reveal>
          <img src={asset('assets/images/product-hair-oil.png')} alt="خدمات تخصصی مراقبت از مو و روغن‌های گیاهی" loading="lazy" />
          <div class="testimonial-overlay">
            <div class="testimonial-content">
              <p>"بهترین مراقبت مویی که تا به حال داشتم."</p>
              <span class="client-name">— نیلوفر م.</span>
            </div>
          </div>
        </div>
        <div class="lookbook-item" data-reveal>
          <img src={asset('assets/images/hair_tools_hands.webp')} alt="تجهیزات مدرن و محیط بهداشتی سالن زیبایی" loading="lazy" />
          <div class="testimonial-overlay">
            <div class="testimonial-content">
              <p>"دقت در جزئیات واقعا در این مجموعه حرف اول را می‌زند."</p>
              <span class="client-name">— مریم راد</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Consultation Section -->
    <section id="consultation" class="consultation">
      <div class="consultation-content" data-reveal>
        <h2>زیبایی، یک سفر شخصی است. <br /> با ما مشورت کنید.</h2>
        <p>تیم متخصص ما آماده است تا بهترین راهکارهای زیبایی را متناسب با نیازهای منحصر به فرد شما ارائه دهد.</p>
        <a href={pageUrl('/booking')} class="btn-premium go-booking" style="background:var(--gold-gradient); color:var(--dark-charcoal)">
          دریافت وقت مشاوره رایگان
        </a>
      </div>
      <div class="consultation-image" data-reveal>
        <img src={asset('assets/images/consultation.webp')} alt="مشاوره زیبایی دلدار" loading="lazy" />
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="faq-section container">
      <div class="section-header" data-reveal>
        <p class="section-tagline">سوالات پرتکرار</p>
        <h2>پاسخ سوال‌های شما</h2>
        <p>هر آنچه قبل از رزرو نوبت و خرید محصولات باید بدانید</p>
      </div>
      <div class="faq-grid">
        {
          FAQS.map((faq) => (
            <div class="faq-item" data-reveal>
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact-section container">
      <div class="section-header" data-reveal>
        <h2>راه‌های ارتباطی</h2>
        <p>منتظر شنیدن صدای گرم شما هستیم</p>
      </div>
      <div class="contact-grid">
        <div class="contact-info">
          <div class="info-item" data-reveal>
            <div class="info-icon">📍</div>
            <div>
              <h4>آدرس مجموعه</h4>
              <p>تهران، خیابان ظفر، پلاک ۱۲۳، واحد ۵</p>
            </div>
          </div>
          <div class="info-item" data-reveal>
            <div class="info-icon">📞</div>
            <div>
              <h4>شماره‌های تماس</h4>
              <p>۰۲۱-۱۲۳۴۵۶۷۸ | ۰۹۱۲-۳۴۵۶۷۸۹</p>
            </div>
          </div>
          <div class="info-item" data-reveal>
            <div class="info-icon">⏰</div>
            <div>
              <h4>ساعات پذیرش</h4>
              <p>شنبه تا پنجشنبه: ۱۰:۰۰ الی ۱۹:۰۰</p>
            </div>
          </div>
        </div>
        <div class="contact-image" data-reveal>
          <img
            src={asset('assets/images/logo.svg')}
            alt="آدرس و راه‌های ارتباطی سالن زیبایی دلدار"
            loading="lazy"
            style="width: 100%; border-radius: 40px; opacity: 0.1; filter: invert(1);"
          />
        </div>
      </div>
    </section>
  </main>
</Layout>