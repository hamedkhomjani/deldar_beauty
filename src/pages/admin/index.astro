---
/**
 * Admin Portal page — manages products, stock, orders, and data export.
 * Accessible at /deldar_beauty/admin/
 */
import Layout from '../../components/Layout.astro';
import { asset, pageUrl } from '../../config';

const lang = 'fa';
---

<Layout title="پورتال مدیریت | سالن زیبایی دلدار" description="پورتال مدیریت محصولات و سفارشات سالن زیبایی دلدار" lang={lang}>
  <main class="admin-portal container">
    <!-- PIN Auth Modal -->
    <div id="admin-auth-overlay" class="admin-auth-overlay">
      <div class="auth-card">
        <img src={asset('assets/images/logo.svg')} alt="Deldar Logo" class="auth-logo" />
        <h2>ورود به پورتال مدیریت</h2>
        <p>لطفاً پین‌کد مدیریتی خود را وارد کنید (پیش‌فرض: 1234)</p>

        <form id="admin-login-form" class="auth-form">
          <div class="form-group">
            <input type="password" id="admin-pin-input" maxlength="10" placeholder="رمز عبور / PIN" required autofocus />
          </div>
          <div id="auth-error" class="auth-error hidden">رمز عبور اشتباه است!</div>
          <button type="submit" class="btn-premium">ورود به سیستم</button>
        </form>
      </div>
    </div>

    <!-- Admin Dashboard Main Screen (Hidden until authenticated) -->
    <div id="admin-dashboard" class="admin-dashboard hidden">
      <!-- Admin Top Nav Header -->
      <header class="admin-header">
        <div class="admin-brand">
          <img src={asset('assets/images/logo.svg')} alt="Deldar Logo" class="admin-header-logo" />
          <div>
            <h1>پورتال مدیریت فروشگاه</h1>
            <span class="admin-badge">مدیر ارشد</span>
          </div>
        </div>
        <div class="admin-header-actions">
          <a href={pageUrl('/shop/')} class="btn-outline" target="_blank">مشاهده فروشگاه ↗</a>
          <button id="admin-logout-btn" class="btn-logout">خروج</button>
        </div>
      </header>

      <!-- Dashboard Navigation Tabs -->
      <nav class="admin-tabs">
        <button class="tab-btn active" data-tab="products-tab">📦 لیست و مدیریت محصولات</button>
        <button class="tab-btn" data-tab="add-product-tab">➕ افزودن محصول جدید</button>
        <button class="tab-btn" data-tab="orders-tab">📋 سفارشات مشتریان (<span id="orders-count-badge">0</span>)</button>
        <button class="tab-btn" data-tab="reviews-tab">⭐ مدیریت نظرات (<span id="reviews-pending-badge">0</span>)</button>
        <button class="tab-btn" data-tab="export-tab">⚡ خروجی کد گیتهاب</button>
      </nav>

      <!-- Tab 1: Products Management -->
      <section id="products-tab" class="tab-content active">
        <div class="tab-header">
          <h2>لیست محصولات فروشگاه</h2>
          <div class="tab-header-tools">
            <input type="text" id="product-search" placeholder="جستجو در محصولات..." class="admin-search-input" />
            <button id="btn-open-add-modal" class="btn-premium">+ افزودن محصول جدید</button>
          </div>
        </div>

        <div class="table-responsive">
          <table class="admin-table">
            <thead>
              <tr>
                <th>تصویر</th>
                <th>نام محصول (فارسی / انگلیسی)</th>
                <th>دسته‌بندی</th>
                <th>قیمت (تومان)</th>
                <th>وضعیت موجودی</th>
                <th>برچسب</th>
                <th>عملیات</th>
              </tr>
            </thead>
            <tbody id="admin-products-table-body">
              <!-- Dynamically populated by client JS -->
            </tbody>
          </table>
        </div>
      </section>

      <!-- Tab 2: Add Product Form -->
      <section id="add-product-tab" class="tab-content">
        <div class="form-container-card">
          <h2>افزودن محصول جدید به فروشگاه</h2>
          <p class="form-subtext">اطلاعات محصول را وارد کنید تا بلافاصله به فروشگاه اضافه شود.</p>

          <form id="add-product-form" class="admin-form">
            <div class="form-grid">
              <div class="form-group">
                <label for="prod-name-fa">نام محصول (فارسی)</label>
                <input type="text" id="prod-name-fa" placeholder="مثلاً: کرم آبرسان الماس" required />
              </div>
              <div class="form-group">
                <label for="prod-name-en">نام محصول (انگلیسی)</label>
                <input type="text" id="prod-name-en" placeholder="e.g. Diamond Hydrating Cream" required />
              </div>

              <div class="form-group">
                <label for="prod-category-fa">دسته‌بندی (فارسی)</label>
                <input type="text" id="prod-category-fa" placeholder="مثلاً: مراقبت از پوست" required />
              </div>
              <div class="form-group">
                <label for="prod-category-en">دسته‌بندی (انگلیسی)</label>
                <input type="text" id="prod-category-en" placeholder="e.g. Skin Care" required />
              </div>

              <div class="form-group">
                <label for="prod-price">قیمت (تومان)</label>
                <input type="number" id="prod-price" min="1000" step="1000" placeholder="1280000" required />
              </div>
              <div class="form-group">
                <label for="prod-image">آدرس تصویر (مسیر یا لینک)</label>
                <input type="text" id="prod-image" placeholder="/assets/images/product-skin-serum.png" required />
              </div>

              <div class="form-group full-width">
                <label for="prod-desc-fa">توضیحات (فارسی)</label>
                <textarea id="prod-desc-fa" rows="3" placeholder="توضیحات کامل محصول..." required></textarea>
              </div>
              <div class="form-group full-width">
                <label for="prod-desc-en">توضیحات (انگلیسی)</label>
                <textarea id="prod-desc-en" rows="3" placeholder="Full product description..." required></textarea>
              </div>

              <div class="form-group">
                <label for="prod-badge-fa">برچسب ویژه (اختیاری - مثلاً پرفروش)</label>
                <input type="text" id="prod-badge-fa" placeholder="پرفروش / جدید / تخفیف" />
              </div>
              <div class="form-group">
                <label for="prod-badge-en">برچسب انگلیسی (اختیاری)</label>
                <input type="text" id="prod-badge-en" placeholder="Bestseller / New" />
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn-premium">ذخیره و انتشار محصول</button>
            </div>
          </form>
        </div>
      </section>

      <!-- Tab 3: Customer Orders List -->
      <section id="orders-tab" class="tab-content">
        <div class="tab-header">
          <h2>سفارشات دریافت شده از مشتریان</h2>
          <button id="btn-clear-orders" class="btn-outline-danger">پاکسازی سفارشات قدیمی</button>
        </div>

        <div id="orders-list-container">
          <!-- Dynamically populated -->
        </div>
      </section>

      <!-- Tab 4: Reviews Management -->
      <section id="reviews-tab" class="tab-content">
        <div class="tab-header">
          <h2>نظرات و تجربیات ثبت‌شده توسط کاربران</h2>
          <div class="filter-buttons">
            <button class="filter-btn active" data-review-filter="all">همه نظرات</button>
            <button class="filter-btn" data-review-filter="pending">در انتظار تایید</button>
            <button class="filter-btn" data-review-filter="approved">تایید شده</button>
            <button class="filter-btn" data-review-filter="rejected">رد شده</button>
          </div>
        </div>

        <div id="reviews-list-container">
          <!-- Dynamically populated -->
        </div>
      </section>

      <!-- Tab 5: Code Export -->
      <section id="export-tab" class="tab-content">
        <div class="form-container-card">
          <h2>خروجی کد دائم برای مخزن GitHub</h2>
          <p class="form-subtext">
            تغییرات شما در مرورگر ذخیره شده است. برای این‌که تغییرات برای همیشه در سورس‌کد سایت ذخیره شوند، می‌توانید کد زیر را کپی کرده و جایگزین فایل <code>src/data/products.ts</code> نمایید.
          </p>

          <div class="export-box">
            <button id="btn-copy-code" class="btn-premium">📋 کپی کد کامل TypeScript</button>
            <pre><code id="export-code-display">/* کد در حال بارگذاری... */</code></pre>
          </div>
        </div>
      </section>
    </div>

    <!-- Edit Product Modal Dialog -->
    <div id="edit-product-modal" class="admin-modal-overlay hidden">
      <div class="modal-card">
        <div class="modal-header">
          <h3>ویرایش محصول</h3>
          <button id="close-edit-modal" class="close-btn">&times;</button>
        </div>
        <form id="edit-product-form" class="admin-form">
          <input type="hidden" id="edit-prod-id" />
          <div class="form-grid">
            <div class="form-group">
              <label for="edit-prod-name-fa">نام محصول (فارسی)</label>
              <input type="text" id="edit-prod-name-fa" required />
            </div>
            <div class="form-group">
              <label for="edit-prod-name-en">نام محصول (انگلیسی)</label>
              <input type="text" id="edit-prod-name-en" required />
            </div>
            <div class="form-group">
              <label for="edit-prod-price">قیمت (تومان)</label>
              <input type="number" id="edit-prod-price" required />
            </div>
            <div class="form-group">
              <label for="edit-prod-category-fa">دسته‌بندی (فارسی)</label>
              <input type="text" id="edit-prod-category-fa" required />
            </div>
            <div class="form-group full-width">
              <label for="edit-prod-desc-fa">توضیحات (فارسی)</label>
              <textarea id="edit-prod-desc-fa" rows="3" required></textarea>
            </div>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn-premium">بروزرسانی محصول</button>
          </div>
        </form>
      </div>
    </div>
  </main>
</Layout>

<script>
  import {
    getAdminProducts,
    addProduct,
    updateProduct,
    deleteProduct,
    toggleStock,
    getCustomerOrders,
    getAdminReviews,
    updateReviewStatus,
    deleteReview,
    verifyAdminPin,
    generateProductsTypeScript,
  } from '../../scripts/adminStore';

  function initAdmin() {
    const authOverlay = document.getElementById('admin-auth-overlay');
    const loginForm = document.getElementById('admin-login-form');
    const pinInput = document.getElementById('admin-pin-input') as HTMLInputElement;
    const authError = document.getElementById('auth-error');
    const dashboard = document.getElementById('admin-dashboard');
    const logoutBtn = document.getElementById('admin-logout-btn');

    // Login Handle
    loginForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const pin = pinInput.value;
      if (verifyAdminPin(pin)) {
        sessionStorage.setItem('deldar_admin_authed', 'true');
        showDashboard();
      } else {
        authError?.classList.remove('hidden');
      }
    });

    // Logout
    logoutBtn?.addEventListener('click', () => {
      sessionStorage.removeItem('deldar_admin_authed');
      location.reload();
    });

    function showDashboard() {
      authOverlay?.classList.add('hidden');
      dashboard?.classList.remove('hidden');
      try { renderProductsTable(); } catch (err) { console.error('Error rendering products:', err); }
      try { renderOrders(); } catch (err) { console.error('Error rendering orders:', err); }
      try { renderAdminReviews(); } catch (err) { console.error('Error rendering reviews:', err); }
      try { renderCodeExport(); } catch (err) { console.error('Error rendering export:', err); }
    }

    // Tabs Switcher using Event Delegation
    const tabsNav = document.querySelector('.admin-tabs');
    tabsNav?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>('.tab-btn');
      if (!btn) return;
      e.preventDefault();

      const targetTab = btn.getAttribute('data-tab');
      document.querySelectorAll('.admin-tabs .tab-btn').forEach((b) => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach((c) => c.classList.remove('active'));

      btn.classList.add('active');
      if (targetTab) {
        document.getElementById(targetTab)?.classList.add('active');
      }
    });

    // "Add Product" button in products tab header switches to add-product-tab
    document.getElementById('btn-open-add-modal')?.addEventListener('click', () => {
      const addTabBtn = document.querySelector<HTMLElement>('.admin-tabs .tab-btn[data-tab="add-product-tab"]');
      addTabBtn?.click();
    });

    // Render Products Table
    function renderProductsTable(searchTerm = '') {
      const tbody = document.getElementById('admin-products-table-body');
      if (!tbody) return;

      let products = getAdminProducts();
      if (searchTerm.trim()) {
        const term = searchTerm.toLowerCase();
        products = products.filter(
          (p) =>
            p.name.fa.toLowerCase().includes(term) ||
            p.name.en.toLowerCase().includes(term) ||
            p.category.fa.toLowerCase().includes(term)
        );
      }

      if (products.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4">هیچ محصولی یافت نشد.</td></tr>`;
        return;
      }

      tbody.innerHTML = products
        .map(
          (p) => `
        <tr>
          <td>
            <img src="${p.image}" alt="${p.alt.fa}" class="table-img" />
          </td>
          <td>
            <strong>${p.name.fa}</strong>
            <br/><small class="text-muted">${p.name.en}</small>
          </td>
          <td>${p.category.fa}</td>
          <td class="font-bold text-gold">${p.price.toLocaleString('fa-IR')} تومان</td>
          <td>
            <button class="stock-toggle-btn ${p.inStock !== false ? 'instock' : 'outstock'}" data-id="${p.id}">
              ${p.inStock !== false ? '✔ موجود' : '✖ ناموجود'}
            </button>
          </td>
          <td>${p.badge ? `<span class="badge-tag">${p.badge.fa}</span>` : '-'}</td>
          <td>
            <div class="action-btns">
              <button class="btn-edit" data-id="${p.id}">ویرایش</button>
              <button class="btn-delete" data-id="${p.id}">حذف</button>
            </div>
          </td>
        </tr>
      `
        )
        .join('');

      // Attach Event Handlers
      tbody.querySelectorAll('.stock-toggle-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          if (id) {
            toggleStock(id);
            renderProductsTable(searchTerm);
            renderCodeExport();
          }
        });
      });

      tbody.querySelectorAll('.btn-delete').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          if (id && confirm('آیا از حذف این محصول اطمینان دارید؟')) {
            deleteProduct(id);
            renderProductsTable(searchTerm);
            renderCodeExport();
          }
        });
      });

      tbody.querySelectorAll('.btn-edit').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          if (id) openEditModal(id);
        });
      });
    }

    // Search Input
    const searchInput = document.getElementById('product-search') as HTMLInputElement;
    searchInput?.addEventListener('input', () => {
      renderProductsTable(searchInput.value);
    });

    // Add Product Form Handle
    const addForm = document.getElementById('add-product-form') as HTMLFormElement;
    addForm?.addEventListener('submit', (e) => {
      e.preventDefault();

      const nameFa = (document.getElementById('prod-name-fa') as HTMLInputElement).value;
      const nameEn = (document.getElementById('prod-name-en') as HTMLInputElement).value;
      const catFa = (document.getElementById('prod-category-fa') as HTMLInputElement).value;
      const catEn = (document.getElementById('prod-category-en') as HTMLInputElement).value;
      const price = Number((document.getElementById('prod-price') as HTMLInputElement).value);
      const image = (document.getElementById('prod-image') as HTMLInputElement).value;
      const descFa = (document.getElementById('prod-desc-fa') as HTMLTextAreaElement).value;
      const descEn = (document.getElementById('prod-desc-en') as HTMLTextAreaElement).value;
      const badgeFa = (document.getElementById('prod-badge-fa') as HTMLInputElement).value;
      const badgeEn = (document.getElementById('prod-badge-en') as HTMLInputElement).value;

      addProduct({
        name: { fa: nameFa, en: nameEn },
        category: { fa: catFa, en: catEn },
        price,
        image,
        alt: { fa: nameFa, en: nameEn },
        description: { fa: descFa, en: descEn },
        ...(badgeFa ? { badge: { fa: badgeFa, en: badgeEn || badgeFa } } : {}),
        inStock: true,
      });

      addForm.reset();
      alert('محصول جدید با موفقیت اضافه شد!');
      // Switch back to products tab
      const productsTabBtn = document.querySelector<HTMLElement>('.admin-tabs .tab-btn[data-tab="products-tab"]');
      productsTabBtn?.click();
      renderProductsTable();
      renderCodeExport();
    });

    // Open Edit Modal
    function openEditModal(id: string) {
      const products = getAdminProducts();
      const product = products.find((p) => p.id === id);
      if (!product) return;

      (document.getElementById('edit-prod-id') as HTMLInputElement).value = product.id;
      (document.getElementById('edit-prod-name-fa') as HTMLInputElement).value = product.name.fa;
      (document.getElementById('edit-prod-name-en') as HTMLInputElement).value = product.name.en;
      (document.getElementById('edit-prod-price') as HTMLInputElement).value = String(product.price);
      (document.getElementById('edit-prod-category-fa') as HTMLInputElement).value = product.category.fa;
      (document.getElementById('edit-prod-desc-fa') as HTMLTextAreaElement).value = product.description.fa;

      document.getElementById('edit-product-modal')?.classList.remove('hidden');
    }

    document.getElementById('close-edit-modal')?.addEventListener('click', () => {
      document.getElementById('edit-product-modal')?.classList.add('hidden');
    });

    // Edit Product Submit
    const editForm = document.getElementById('edit-product-form') as HTMLFormElement;
    editForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const id = (document.getElementById('edit-prod-id') as HTMLInputElement).value;
      const nameFa = (document.getElementById('edit-prod-name-fa') as HTMLInputElement).value;
      const nameEn = (document.getElementById('edit-prod-name-en') as HTMLInputElement).value;
      const price = Number((document.getElementById('edit-prod-price') as HTMLInputElement).value);
      const catFa = (document.getElementById('edit-prod-category-fa') as HTMLInputElement).value;
      const descFa = (document.getElementById('edit-prod-desc-fa') as HTMLTextAreaElement).value;

      const products = getAdminProducts();
      const prod = products.find((p) => p.id === id);
      if (prod) {
        updateProduct(id, {
          name: { fa: nameFa, en: nameEn || prod.name.en },
          price,
          category: { fa: catFa, en: prod.category.en },
          description: { fa: descFa, en: prod.description.en },
        });
      }

      document.getElementById('edit-product-modal')?.classList.add('hidden');
      renderProductsTable();
      renderCodeExport();
    });

    // Render Orders
    function renderOrders() {
      const container = document.getElementById('orders-list-container');
      const badge = document.getElementById('orders-count-badge');
      const orders = getCustomerOrders();

      if (badge) badge.textContent = String(orders.length);
      if (!container) return;

      if (orders.length === 0) {
        container.innerHTML = `<div class="empty-orders">هنوز هیچ سفارشی از سمت خریداران ثبت نشده است.</div>`;
        return;
      }

      container.innerHTML = `
        <div class="orders-grid">
          ${orders
            .map(
              (o) => `
            <div class="order-card">
              <div class="order-card-header">
                <div>
                  <span class="order-id">شماره سفارش: ${o.id}</span>
                  <div class="order-date">${o.date}</div>
                </div>
                <span class="order-status-tag ${o.status}">${o.status === 'pending' ? 'در حال بررسی' : 'تکمیل شده'}</span>
              </div>
              <div class="order-customer">
                <div><strong>نام خریدار:</strong> ${o.customerName}</div>
                <div><strong>شماره تماس:</strong> <a href="tel:${o.phone}">${o.phone}</a></div>
                <div><strong>آدرس:</strong> ${o.address || 'ثبت نشده'}</div>
              </div>
              <div class="order-items">
                <strong>اقلام سفارش:</strong>
                <ul>
                  ${o.items.map((i) => `<li>${i.name} × ${i.qty} (${(i.price * i.qty).toLocaleString('fa-IR')} تومان)</li>`).join('')}
                </ul>
              </div>
              <div class="order-card-footer">
                <span>مبلغ کل:</span>
                <strong class="text-gold">${o.totalPrice.toLocaleString('fa-IR')} تومان</strong>
              </div>
            </div>
          `
            )
            .join('')}
        </div>
      `;
    }

    // Clear orders
    document.getElementById('btn-clear-orders')?.addEventListener('click', () => {
      if (confirm('آیا از پاکسازی تمام سفارشات اطمینان دارید؟')) {
        localStorage.removeItem('deldar_customer_orders');
        renderOrders();
      }
    });

    // Reviews Management
    let activeReviewFilter = 'all';

    function renderAdminReviews() {
      const container = document.getElementById('reviews-list-container');
      const badge = document.getElementById('reviews-pending-badge');
      if (!container) return;

      const reviews = getAdminReviews();
      const pendingCount = reviews.filter((r) => r.status === 'pending').length;
      if (badge) badge.textContent = String(pendingCount);

      const filtered = reviews.filter((r) => {
        if (activeReviewFilter === 'pending') return r.status === 'pending';
        if (activeReviewFilter === 'approved') return r.status === 'approved';
        if (activeReviewFilter === 'rejected') return r.status === 'rejected';
        return true;
      });

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="empty-state-card">
            <p>هیچ نظری در این بخش وجود ندارد.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = `
        <div class="reviews-admin-grid">
          ${filtered
            .map((r) => {
              const statusLabel =
                r.status === 'approved' ? 'تایید شده' : r.status === 'rejected' ? 'رد شده' : 'در انتظار تایید';
              const statusClass =
                r.status === 'approved' ? 'badge-success' : r.status === 'rejected' ? 'badge-danger' : 'badge-warning';
              const stars = '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating);

              return `
                <div class="admin-review-card">
                  <div class="review-card-header">
                    <div>
                      <strong>${r.name}</strong>
                      <span class="review-service-tag">${r.service}</span>
                    </div>
                    <span class="status-badge ${statusClass}">${statusLabel}</span>
                  </div>
                  <div class="admin-review-stars">${stars} (${r.rating}/5)</div>
                  <p class="admin-review-text">"${r.text}"</p>
                  <div class="review-card-meta">
                    <span class="date">${r.date}</span>
                    <div class="review-actions">
                      ${r.status !== 'approved' ? `<button class="btn-sm btn-approve" data-rev-id="${r.id}">✓ تایید و انتشار</button>` : ''}
                      ${r.status !== 'rejected' ? `<button class="btn-sm btn-reject" data-rev-id="${r.id}">✕ رد نظر</button>` : ''}
                      <button class="btn-sm btn-delete-rev" data-rev-id="${r.id}">🗑️ حذف</button>
                    </div>
                  </div>
                </div>
              `;
            })
            .join('')}
        </div>
      `;

      // Event Listeners for Review Action buttons
      container.querySelectorAll('.btn-approve').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-rev-id');
          if (id) {
            updateReviewStatus(id, 'approved');
            renderAdminReviews();
          }
        });
      });

      container.querySelectorAll('.btn-reject').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-rev-id');
          if (id) {
            updateReviewStatus(id, 'rejected');
            renderAdminReviews();
          }
        });
      });

      container.querySelectorAll('.btn-delete-rev').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-rev-id');
          if (id && confirm('آیا از حذف این نظر اطمینان دارید؟')) {
            deleteReview(id);
            renderAdminReviews();
          }
        });
      });
    }

    // Filter Button Click Listener (Event Delegation)
    const filterBtnContainer = document.querySelector('.filter-buttons');
    filterBtnContainer?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-review-filter]');
      if (!btn) return;
      document.querySelectorAll('[data-review-filter]').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeReviewFilter = btn.getAttribute('data-review-filter') ?? 'all';
      renderAdminReviews();
    });

    // Code Export
    function renderCodeExport() {
      const codeDisplay = document.getElementById('export-code-display');
      if (codeDisplay) {
        const products = getAdminProducts();
        codeDisplay.textContent = generateProductsTypeScript(products);
      }
    }

    document.getElementById('btn-copy-code')?.addEventListener('click', () => {
      const codeDisplay = document.getElementById('export-code-display');
      if (codeDisplay?.textContent) {
        navigator.clipboard.writeText(codeDisplay.textContent);
        alert('کد کامل فایل products.ts با موفقیت کپی شد!');
      }
    });

    // Auto check session (run after all event listeners and handlers are defined)
    if (sessionStorage.getItem('deldar_admin_authed') === 'true') {
      showDashboard();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAdmin);
  } else {
    initAdmin();
  }
</script>

