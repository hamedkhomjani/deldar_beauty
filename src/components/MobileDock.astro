---
/** Mobile sticky booking dock — appears after scrolling (see ui.ts). */
import { localizedPath, t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'fa' } = Astro.props;
const dict = t(lang);
---

<div class="mobile-booking-dock">
  <a class="btn-dock-booking" href={localizedPath('/booking', lang)}>
    <span>{dict.dockCta}</span>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d={dict.arrowForwardD} />
    </svg>
  </a>
</div>
