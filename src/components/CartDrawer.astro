---
/** Slide-in shopping cart drawer — rendered by cart.ts. */
import { t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'fa' } = Astro.props;
const dict = t(lang);
---

<div id="cart-overlay" class="cart-overlay"></div>

<div id="cart-drawer" class="cart-drawer" role="dialog" aria-modal="true" aria-label={dict.cartDrawerAria}>
  <div class="cart-header">
    <h2>{dict.cartTitle}</h2>
    <button class="close-cart" id="close-cart" aria-label={dict.cartCloseAria}>&times;</button>
  </div>

  <div class="cart-items-container" id="cart-items">
    <div class="cart-empty-msg">{dict.cartEmpty}</div>
  </div>

  <div class="cart-footer" id="cart-footer">
    <div class="cart-total">
      <span>{dict.cartTotalLabel}</span>
      <span class="amount" id="cart-total-amount">{dict.cartZero}</span>
    </div>
    <button class="btn-checkout">{dict.cartCheckoutBtn}</button>
  </div>
</div>
