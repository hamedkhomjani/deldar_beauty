---
/** Slide-in shopping cart drawer — rendered by cart.ts. */
---

<div id="cart-overlay" class="cart-overlay"></div>

<div id="cart-drawer" class="cart-drawer" role="dialog" aria-modal="true" aria-label="سبد خرید">
  <div class="cart-header">
    <h2>سبد خرید</h2>
    <button class="close-cart" id="close-cart" aria-label="بستن سبد خرید">&times;</button>
  </div>

  <div class="cart-items-container" id="cart-items">
    <div class="cart-empty-msg">سبد خرید شما فعلاً خالی است.</div>
  </div>

  <div class="cart-footer">
    <div class="cart-total">
      <span>جمع کل:</span>
      <span class="amount" id="cart-total-amount">۰ تومان</span>
    </div>
    <button class="btn-checkout">تایید و پرداخت نهایی</button>
  </div>
</div>