---
/**
 * Page shell — head, chrome (header/footer/cart), global styles and scripts.
 * All pages share this; only <slot> content differs.
 *
 * `lang` switches the document language/direction ('fa' → rtl at the root,
 * 'en' → ltr under /en/) and is forwarded to every chrome component.
 *
 * Checkout page uses `checkout={true}`: booking modal, cart drawer, mobile
 * dock and menu are omitted, and scripts are limited to cursor/ui/checkout.
 */
import Head from './Head.astro';
import Header from './Header.astro';
import MobileMenu from './MobileMenu.astro';
import Footer from './Footer.astro';
import CartDrawer from './CartDrawer.astro';
import BookingModal from './BookingModal.astro';
import Cursor from './Cursor.astro';
import GrainOverlay from './GrainOverlay.astro';
import FloatingButton from './FloatingButton.astro';
import MobileDock from './MobileDock.astro';
import type { Lang } from '../i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Page locale — drives <html lang/dir> and all chrome text */
  lang?: Lang;
  /** Extra classes on <body> (e.g. "home-page") */
  bodyClass?: string;
  /** JSON-LD blocks for this page */
  jsonLd?: Record<string, unknown>[];
  canonical?: string;
  ogImage?: string;
  preloadHero?: boolean;
  robots?: 'index, follow' | 'noindex, nofollow';
  /** Minimal chrome + checkout scripts (checkout page only) */
  checkout?: boolean;
  /** Hide the booking modal (the standalone booking page provides its own) */
  noBookingModal?: boolean;
  /** Hide the mobile booking dock (the standalone booking page has its own confirm button) */
  hideBookingDock?: boolean;
}

const {
  title,
  description,
  lang = 'fa',
  bodyClass = '',
  jsonLd = [],
  canonical,
  ogImage,
  preloadHero = false,
  robots,
  checkout = false,
  noBookingModal = false,
  hideBookingDock = false,
} = Astro.props;

const dir = lang === 'en' ? 'ltr' : 'rtl';
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <Head
      title={title}
      description={description}
      lang={lang}
      canonical={canonical}
      ogImage={ogImage}
      jsonLd={jsonLd}
      preloadHero={preloadHero}
      robots={robots}
    />
  </head>

  <body class:list={[bodyClass]}>
    <Cursor />
    {!checkout && <GrainOverlay />}
    {!checkout && <FloatingButton />}
    {!checkout && !hideBookingDock && <MobileDock lang={lang} />}

    <Header minimal={checkout} lang={lang} />
    {!checkout && <MobileMenu lang={lang} />}

    <slot />

    {!checkout && <Footer lang={lang} />}
    {!checkout && <CartDrawer lang={lang} />}
    {!checkout && !noBookingModal && <BookingModal lang={lang} />}

    {checkout ? (
      <>
        <script src="../scripts/cursor.ts" />
        <script src="../scripts/ui.ts" />
        <script src="../scripts/checkout.ts" />
      </>
    ) : (
      <>
        <script src="../scripts/cursor.ts" />
        <script src="../scripts/ui.ts" />
        <script src="../scripts/booking.ts" />
        <script src="../scripts/cart.ts" />
      </>
    )}
  </body>
</html>
