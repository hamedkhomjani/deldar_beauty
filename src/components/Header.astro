---
/**
 * Shared header/nav. The current page is highlighted automatically.
 * `minimal` renders the checkout variant: nav links + theme toggle only.
 */
import { NAV_LINKS, asset, pageUrl } from '../config';

interface Props {
  minimal?: boolean;
}

const { minimal = false } = Astro.props;

const pathname = Astro.url.pathname
  .replace(import.meta.env.BASE_URL, '/')
  .replace(/\/$/, '') || '/';

function isActive(link: string): boolean {
  // Page links (/, /about, /shop) highlight on exact match;
  // anchor links (/#services) never highlight.
  if (link.startsWith('/#') || link === '/') return link === '/' ? pathname === '/' : false;
  return pathname === link;
}
---

<header id="main-header">
  <nav class="container">
    <div class="logo">
      <a href={pageUrl('/')} aria-label="صفحه اصلی سالن زیبایی دلدار">
        <img src={asset('assets/images/logo.svg')} alt="لوگوی سالن زیبایی دلدار" />
      </a>
    </div>

    <div class="nav-links desktop-only">
      {
        NAV_LINKS.map((link) => (
          <a href={pageUrl(link.href)} class:list={[{ active: isActive(link.href) }]}>
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="header-actions">
      {
        !minimal && (
          <button id="cart-toggle" class="cart-toggle" aria-label="باز کردن سبد خرید">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span class="cart-count">۰</span>
          </button>
        )
      }

      <button id="theme-toggle" class="theme-toggle" aria-label="تغییر حالت روشن و تاریک">
        <svg class="sun-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="moon-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      {
        !minimal && (
          <div class="menu-icon" id="menu-toggle" aria-label="باز کردن منو">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
              <rect y="4" width="24" height="2" rx="1" />
              <rect y="11" width="24" height="2" rx="1" />
              <rect y="18" width="24" height="2" rx="1" />
            </svg>
          </div>
        )
      }
    </div>
  </nav>
</header>